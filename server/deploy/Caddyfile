# Caddy alternative to nginx (automatic HTTPS). Server env: HOST=127.0.0.1 PORT=8787 TRUST_PROXY=1.
# Privacy: there is deliberately no `log` directive, so Caddy keeps no access log (it would store full client IPs).
# If you need one, mask the addresses (Caddy ≥ 2.7):
#   log {
#     format filter {
#       fields {
#         request>remote_ip ip_mask {
#           ipv4 24
#           ipv6 48
#         }
#         request>client_ip ip_mask {
#           ipv4 24
#           ipv6 48
#         }
#         request>headers>X-Real-Ip delete
#         request>headers>X-Forwarded-For delete
#       }
#     }
#   }
mp.leonida-drive.io {
	@ws path /ws
	reverse_proxy @ws 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
	handle /health {
		reverse_proxy 127.0.0.1:8787
	}
	# public player count for the start screen (JSON, cached 5 s, CORS for ALLOWED_ORIGINS — set by the server)
	handle /status {
		reverse_proxy 127.0.0.1:8787
	}
	respond 404
}
